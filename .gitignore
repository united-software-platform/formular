.env
.idea/

# Окружение и кэш интерпретатора
__pycache__/

# Каталог следа операций: порождённые беклоги принадлежат прогону, а не репозиторию.
backlog/*

# Локальная регистрация харнесов: ссылки на навыки tessera (ведут в хранилище машины)
# создаёт каждый разработчик под свои инструменты. В .claude/ в индексе только
# инструментация OpenSpec — навыки openspec-* и команды opsx; остальное там локальное.
.agents/
.zcode/
.claude/*
!.claude/commands
!.claude/skills
.claude/skills/*
!.claude/skills/openspec-*

# Реестр-факт установки tessera на этой машине: описывает машину и момент запуска.
# Копии правил в .tessera/rules/ и секция AGENTS.md переносимы и коммитятся вместе с проектом.
.tessera/registry.json
